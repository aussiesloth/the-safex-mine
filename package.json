{
  "name": "the-safex-mine",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:helper": "cargo build --manifest-path src-tauri/helper/Cargo.toml --release",
    "tauri:build": "npm run build:helper && npm run licenses:bundle && tauri build --config src-tauri/tauri.release.conf.json",
    "licenses:audit": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit-dependency-licenses.ps1",
    "licenses:bundle": "powershell -ExecutionPolicy Bypass -File .\\scripts\\generate-third-party-licenses.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
