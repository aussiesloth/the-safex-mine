{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Safex Mine",
  "version": "0.1.0",
  "identifier": "com.aussiesloth.thesafexmine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "The Safex Mine",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "helper/target/release/safex-mine-helper.exe": "runtime/safex-mine-helper.exe",
      "binaries/safex-xmrig-x86_64-pc-windows-msvc.exe": "runtime/safex-xmrig-x86_64-pc-windows-msvc.exe",
      "binaries/WinRing0x64.sys": "runtime/WinRing0x64.sys",
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES/WinRing0-LICENSE.txt": "licenses/WinRing0-LICENSE.txt"
    },
    "licenseFile": "../LICENSE"
  }
}
